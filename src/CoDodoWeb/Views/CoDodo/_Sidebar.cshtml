@{
  string? currentAction = ViewContext.RouteData.Values["action"] as string;
  bool opportunitiesActive = !string.Equals(currentAction, "Processes");
  bool processesActive = string.Equals(currentAction, "Processes");
}

<div class="card">
  <div class="card-body">
    <h2 class="h6 text-uppercase text-muted mb-3">CoDodo</h2>
    <div class="list-group list-group-flush">
      <a class="list-group-item list-group-item-action @(opportunitiesActive ? "active" : string.Empty)"
         asp-controller="CoDodo"
         asp-action="Index">
        Opportunities
      </a>
      <a class="list-group-item list-group-item-action @(processesActive ? "active" : string.Empty)"
         asp-controller="CoDodo"
         asp-action="Processes">
        Processes
      </a>
    </div>
  </div>
</div>
